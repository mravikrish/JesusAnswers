# Copy to .env (never commit it) or set these in your host's secret manager.

# Claude (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/jesusanswers
DATABASE_USER=jesusanswers
DATABASE_PASSWORD=

# Firebase project id (Project settings → General)
FIREBASE_PROJECT_ID=

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing this key makes every stored journey entry unreadable — back it up.
JOURNEY_ENCRYPTION_KEY=

ANSWERS_PER_HOUR=30
